CXX_STD = CXX17

# src/pgenlib: unmodified pgenlib sources (plink-ng, LGPL >= 3); flags as in pgenlibr.
PGENLIB_OBJECTS = pgenlib/pgenlib_misc.o pgenlib/pgenlib_read.o pgenlib/plink2_base.o \
  pgenlib/plink2_bits.o pgenlib/plink2_simd.o
OBJECTS = RcppExports.o bed_cor.o cppmatrix.o pgen_cor.o $(PGENLIB_OBJECTS)

PKG_CPPFLAGS = -DNO_UNALIGNED -DPGENLIB_NOPRINT -Ipgenlib
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
